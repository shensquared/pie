# sudo nano /etc/systemd/system/pie.service
# sudo systemctl enable pie.service
# sudo systemctl restart pie
[Unit]
Description=Gunicorn instance to serve pie
After=network.target

[Service]
User=shenshen
Group=www-data
WorkingDirectory=/home/shenshen/code/pie
Environment="PATH=/home/shenshen/code/pie/.venv/bin"
ExecStart=/home/shenshen/code/pie/.venv/bin/gunicorn --workers 13 --bind 127.0.0.1:4999  -m 007 wsgi:server

[Install]
WantedBy=multi-user.target
