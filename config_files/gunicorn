# sudo nano /etc/systemd/system/<dashboard>.service
[Unit]
Description=Gunicorn instance to serve dashboard
After=network.target

[Service]
User=shensquared
Group=www-data
WorkingDirectory=/home/shensquared/coursedashboard/
Environment="PATH=/home/shensquared/coursedashboard/venv/bin"
ExecStart=/home/shensquared/coursedashboard/venv/bin/gunicorn --workers 9 --bind 127.0.0.1:4999  -m 007 wsgi:server

[Install]
WantedBy=multi-user.target
